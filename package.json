{
  "name": "la-voz-misionera",
  "private": true,
  "version": "1.1.0",
  "engines": { "node": ">=22.22.2" },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "npm run dev -w @lavozmisionera/web",
    "dev:mock": "npm run dev:mock -w @lavozmisionera/web",
    "build": "npm run build -w @lavozmisionera/web",
    "build:mock": "npm run build:mock -w @lavozmisionera/web",
    "preview": "npm run preview -w @lavozmisionera/web",
    "test": "npm run test -w @lavozmisionera/web",
    "test:run": "npm run test:run -w @lavozmisionera/web",
    "test:mvp": "npm run test:mvp -w @lavozmisionera/web",
    "lint": "npm run lint -w @lavozmisionera/web",
    "i18n:check": "npm run i18n:check -w @lavozmisionera/web",
    "generate:sitemap": "npm run generate:sitemap -w @lavozmisionera/web",
    "generate:licenses": "npm run generate:licenses -w @lavozmisionera/web",
    "tokens:swift": "npm run generate:swift -w @lavozmisionera/tokens",
    "tokens:swift:check": "npm run generate:swift:check -w @lavozmisionera/tokens"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  }
}
